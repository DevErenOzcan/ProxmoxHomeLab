# Local secrets, copied to .env (git-ignored) and never to a managed host.
# run_ansible.sh parses this file and exports it into the environment of the
# ansible run, which is how roles/opnsense_config receives the API credentials:
# as environment variables, so they stay off the firewall's disk and out of
# any command line.

# OPNsense API credentials. The variable NAMES matter - the role reads exactly
# these two through lookup('env', ...).
# Create them once in the GUI: System -> Access -> Users -> root -> "API keys"
# -> + , which downloads a file holding a key and a secret.
OPNSENSE_API_KEY=opnsenseapikey
OPNSENSE_API_SECRET=opnsenseapisecret

# Proxmox root password. Nothing reads this any more: it belonged to the
# deleted state_push_* scripts, and terraform takes the same value as
# TF_VAR_proxmox_password or from
# terraform/environments/production/secret.tfvars.
proxmox_passwd=PROXMOX_SIFRENIZI_BURAYA_YAZIN
