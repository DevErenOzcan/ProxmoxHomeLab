# Local secrets. Copy to .env (git-ignored); it never goes to a managed host.
#
# NOTHING loads this file automatically. roles/opnsense_config reads the two
# OPNsense values as ENVIRONMENT VARIABLES, so put them into the environment of
# the run itself - from ansible/:
#
#   env $(grep '^OPNSENSE_API_' ../.env) ANSIBLE_CONFIG=ansible.cfg ansible-playbook playbooks/opnsense/site.yml
#
# That keeps them off the firewall's disk and out of any command line. Do not
# "source" this file: a password may hold a character the shell acts on.

# OPNsense API credentials. The variable NAMES matter - the role reads exactly
# these two through lookup('env', ...). Create them once in the GUI:
# System -> Access -> Users -> root -> "API keys" -> + (opnsense-bootstrap.md).
OPNSENSE_API_KEY=opnsenseapikey
OPNSENSE_API_SECRET=opnsenseapisecret

# Optional: the Proxmox root password, for your own password-based SSH tooling.
# Nothing in this repo reads it; Terraform takes the same value from
# terraform/environments/production/secret.tfvars.
proxmox_passwd=your-proxmox-root-password
